# ResearchOS Frontend Configuration
# Copy this file to .env.local and fill in your values
# NEVER commit .env.local to version control

# ────────────────────────────────────────────────────────────────────────────
# API ENDPOINTS
# ────────────────────────────────────────────────────────────────────────────

# FieldScore backend ("engine") base URL — the API this app calls.
# Development: http://localhost:5000
# Production:  https://fieldscore.intelligencyai.com.ng
# NOTE: Create React App inlines this at BUILD time, so after changing it in
# Vercel you must trigger a redeploy for the new value to take effect.
REACT_APP_API_URL=http://localhost:5000

# InsightScore is no longer called directly from the browser (that required
# shipping an auth-free API, or a server-to-server secret, into public JS —
# both unacceptable). insightScoreApi in src/services/api.ts now goes through
# FieldScore's authenticated proxy at REACT_APP_API_URL + /insights/*, which
# forwards to InsightScore server-to-server. No separate URL needed here.

# ────────────────────────────────────────────────────────────────────────────
# APPLICATION SETTINGS
# ────────────────────────────────────────────────────────────────────────────

# Environment (development, staging, production)
REACT_APP_ENVIRONMENT=development

# Feature flags
REACT_APP_ENABLE_INSIGHTS=true
REACT_APP_ENABLE_ADA=true
REACT_APP_ENABLE_KOBO_IMPORT=true
# CallScore (remote phone interviews). Off until its backend is mapped to the
# production domain — see src/features.ts. Set to true AND point
# REACT_APP_CALLSCORE_API_URL at the CallScore service to re-enable.
REACT_APP_ENABLE_CALLSCORE=false

# ────────────────────────────────────────────────────────────────────────────
# ADA VOICE (optional — falls back to Web Speech)
# ────────────────────────────────────────────────────────────────────────────
# Any client-side (REACT_APP_*) key is compiled into the public JS bundle and
# readable by anyone via devtools — do not add a REACT_APP_OPENAI_KEY back.
# If OpenAI TTS is wanted again, proxy it through the backend instead.
#
# ElevenLabs voice for Ada was previously configured here as
# REACT_APP_ELEVENLABS_KEY, which shipped the key to every browser — moved
# server-side. Set ELEVENLABS_API_KEY / ELEVENLABS_VOICE_ID in
# fieldscore-backend's environment instead; the frontend calls /ada/speak.

# ────────────────────────────────────────────────────────────────────────────
# NOTES
# ────────────────────────────────────────────────────────────────────────────
#
# DO NOT add to this file:
#   - API keys or tokens (should be server-side only)
#   - Hardcoded server URLs (use relative URLs or CORS proxy)
#   - Personal email addresses
#   - Database credentials
#   - Admin passwords
#   - Firebase keys (only use from authentication context)
#   - AWS secrets
#   - Any PII
#
# These values will be visible in the built bundle and browser.
# Only add values that are safe to expose to the client.
#
# For sensitive configuration, create backend API endpoints that return
# non-sensitive config values (like contact emails from /api/config/public).
